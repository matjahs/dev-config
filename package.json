{
  "name": "@matjahs/dev-config",
  "version": "0.1.0",
  "description": "Scaffold personal ESLint, Prettier, tsconfig, and EditorConfig into new projects",
  "type": "module",
  "bin": {
    "matjahs-dev-config": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "release": "semantic-release"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matjahs/dev-config.git"
  },
  "author": "Matjah Sonneveld",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.20.1",
    "semantic-release": "^24.2.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0"
  }
}
