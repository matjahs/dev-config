{
  "name": "@matjahs/dev-config",
  "version": "1.0.1",
  "description": "Scaffold personal ESLint, Prettier, tsconfig, and EditorConfig into new projects",
  "type": "module",
  "bin": {
    "matjahs-dev-config": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "test": "npm run smoke",
    "release": "semantic-release"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matjahs/dev-config.git"
  },
  "author": "Matjah Sonneveld",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.1.2",
    "semantic-release": "^25.0.8",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0"
  }
}
